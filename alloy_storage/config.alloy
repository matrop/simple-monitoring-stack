// Forward to Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Optional: HTTP log ingestion endpoint
loki.source.api "http_ingest" {
  http {
    listen_address = "0.0.0.0"
    listen_port = 12346
  }
  forward_to = [loki.write.local.receiver]
}

// Setup trace collection via tempo
otelcol.receiver.otlp "default" {
  grpc {}
  http {}

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true     // Only suitable for non-production
    }
  }
}
